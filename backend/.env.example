# Kopiraj v backend/.env in po potrebi spremeni vrednosti.

# Vrata, na katerih teče API
PORT=3000

# Povezava do MongoDB.
# - lokalni zagon (npm run start:dev):  mongodb://localhost:27017/plantpals
# - v Dockerju docker-compose to vrednost samodejno nastavi na mongodb://mongo:27017/plantpals
MONGO_URI=mongodb://localhost:27017/plantpals

# Skrivnost za podpisovanje JWT žetonov (uporabljeno pri prijavi, US-03).
# Zamenjaj z dolgim naključnim nizom!
JWT_SECRET=spremeni-me
JWT_EXPIRES_IN=1d

# Naslov frontenda, ki sme klicati API (CORS)
CORS_ORIGIN=http://localhost:5173
